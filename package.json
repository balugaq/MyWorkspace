{
  "name": "myworkspace",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "update-dependencies": "node scripts/update-dependencies.mjs",
    "predev": "node scripts/update-dependencies.mjs",
    "prebuild": "node scripts/update-dependencies.mjs",
    "lint": "eslint",
    "check:peer-deps": "node --experimental-strip-types scripts/check-peer-deps.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "deploy": "next build",
    "serve": "node scripts/serve-static.mjs",
    "deploy:local": "next build && node scripts/serve-static.mjs"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/postcss": "^4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.152",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.7",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.31.0",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.11",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pinyin-pro": "^3.29.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.1.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
